<ui:FluentWindow x:Class="GameTrainerLauncher.UI.Views.TrainerVersionPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource TrainerVersionDialogTitle}"
                 Height="560"
                 Width="860"
                 MinHeight="560"
                 MinWidth="860"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 Icon="/Assets/logo.ico"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource DialogTextBrush}"
                 FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <Style x:Key="TrainerVersionActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="TrainerVersionPrimaryActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource BluePrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="TrainerVersionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DialogMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TrainerVersionCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DialogTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{DynamicResource TrainerVersionDialogTitle}"
                     Background="{DynamicResource ShellTopBarBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/logo.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="18"
                    Background="{DynamicResource DialogHeaderBrush}"
                    BorderBrush="{DynamicResource DialogBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40"
                            Height="40"
                            CornerRadius="10"
                            Background="{DynamicResource AccentSoftBrush}"
                            Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="Games24"
                                       Foreground="{DynamicResource DialogAccentBrush}"
                                       FontSize="22" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="SummaryText"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DialogTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource DialogMutedBrush}"
                                   Text="{DynamicResource TrainerVersionDialogHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,16,0,0"
                    Background="{DynamicResource DialogCardBrush}"
                    BorderBrush="{DynamicResource DialogBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource TrainerVersionHeaderTextStyle}"
                                   Text="{DynamicResource TrainerVersionColumnVersion}" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource TrainerVersionHeaderTextStyle}"
                                   Text="{DynamicResource TrainerVersionColumnDate}" />
                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource TrainerVersionHeaderTextStyle}"
                                   Text="{DynamicResource TrainerVersionColumnSize}" />
                    </Grid>

                    <ListView x:Name="OptionsListView"
                              Grid.Row="1"
                              Margin="10,0,10,10"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                        <Border Width="4"
                                                CornerRadius="2"
                                                Background="{DynamicResource AccentPrimaryBrush}"
                                                Margin="0,2,12,2" />
                                        <TextBlock Style="{StaticResource TrainerVersionCellTextStyle}"
                                                   Text="{Binding Label}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource TrainerVersionCellTextStyle}"
                                               Margin="0,0,12,0"
                                               Text="{Binding PublishedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue=-}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource TrainerVersionCellTextStyle}"
                                               Text="{Binding FileSizeText, TargetNullValue=-}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DialogMutedBrush}"
                           Text="{DynamicResource TrainerVersionDialogFooter}" />

                <ui:Button DockPanel.Dock="Right"
                           Style="{StaticResource TrainerVersionPrimaryActionButtonStyle}"
                           Click="Confirm_Click"
                           Content="{DynamicResource TrainerVersionConfirm}" />
                <ui:Button DockPanel.Dock="Right"
                           Style="{StaticResource TrainerVersionActionButtonStyle}"
                           Appearance="Secondary"
                           Click="Cancel_Click"
                           Content="{DynamicResource TrainerVersionCancel}" />
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

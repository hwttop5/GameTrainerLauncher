<ui:FluentWindow x:Class="GameTrainerLauncher.UI.Views.UpdatePromptWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource UpdateDialogTitle}"
                 Height="560"
                 Width="760"
                 MinHeight="560"
                 MinWidth="760"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 Icon="/Assets/logo.ico"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource DialogTextBrush}"
                 FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <Style x:Key="UpdateActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="UpdatePrimaryActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource BluePrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{DynamicResource UpdateDialogTitle}"
                     Background="{DynamicResource ShellTopBarBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/logo.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="18"
                    Background="{DynamicResource DialogHeaderBrush}"
                    BorderBrush="{DynamicResource DialogBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40"
                            Height="40"
                            CornerRadius="10"
                            Background="{DynamicResource AccentWarningSoftBrush}"
                            Margin="0,0,14,0">
                        <TextBlock Text="!"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentWarningBrush}"
                                   FontSize="22"
                                   FontWeight="Bold" />
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource UpdateDialogTitle}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DialogTextBrush}" />
                        <TextBlock x:Name="SummaryText"
                                   Margin="0,8,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DialogMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Padding="11,5"
                            Margin="16,0,0,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource DialogBadgeBackgroundBrush}"
                            BorderBrush="{DynamicResource DialogBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="{DynamicResource UpdateReleaseNotes}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DialogAccentBrush}" />
                    </Border>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1"
                       Margin="4,16,0,10"
                       Text="{DynamicResource UpdateReleaseNotes}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DialogMutedBrush}" />

            <Border Grid.Row="2"
                    Background="{DynamicResource DialogCardBrush}"
                    BorderBrush="{DynamicResource DialogBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <ScrollViewer Margin="1"
                              Background="{DynamicResource DialogCardBrush}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <TextBlock x:Name="ReleaseNotesTextBlock"
                               Margin="18"
                               FontSize="13"
                               LineHeight="20"
                               Foreground="{DynamicResource DialogTextBrush}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Row="3" Margin="0,18,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource DialogMutedBrush}"
                           Text="Velopack - GitHub Releases"
                           Opacity="0.85" />

                <ui:Button DockPanel.Dock="Right"
                           Style="{StaticResource UpdatePrimaryActionButtonStyle}"
                           Click="UpdateNow_Click"
                           Content="{DynamicResource UpdateNow}" />
                <ui:Button DockPanel.Dock="Right"
                           Style="{StaticResource UpdateActionButtonStyle}"
                           Appearance="Secondary"
                           Click="RemindLater_Click"
                           Content="{DynamicResource UpdateLater}" />
                <ui:Button DockPanel.Dock="Right"
                           Style="{StaticResource UpdateActionButtonStyle}"
                           Appearance="Secondary"
                           Click="SkipVersion_Click"
                           Content="{DynamicResource UpdateSkipVersion}" />
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

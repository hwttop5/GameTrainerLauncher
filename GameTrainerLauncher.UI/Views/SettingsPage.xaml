<Page x:Class="GameTrainerLauncher.UI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{DynamicResource NavSettings}"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                <TextBlock Text="{DynamicResource NavSettings}"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{DynamicResource SettingsSubtitle}"
                           Margin="0,5,0,18"
                           Style="{StaticResource PageSubtitleTextStyle}" />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,7,0"
                            Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LabelLanguage}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="{DynamicResource StrongTextBrush}"
                                       Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="LangEn"
                                             Grid.Column="0"
                                             Content="English"
                                             GroupName="Lang"
                                             Tag="en-US"
                                             Checked="Language_Checked"
                                             Margin="0,0,12,0" />
                                <RadioButton x:Name="LangZh"
                                             Grid.Column="1"
                                             Content="中文"
                                             GroupName="Lang"
                                             Tag="zh-CN"
                                             Checked="Language_Checked" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Margin="7,0,0,0"
                            Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LabelTheme}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="{DynamicResource StrongTextBrush}"
                                       Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="ThemeLight"
                                             Grid.Column="0"
                                             Content="{DynamicResource ThemeLight}"
                                             GroupName="Theme"
                                             Tag="Light"
                                             Checked="Theme_Checked"
                                             Margin="0,0,12,0" />
                                <RadioButton x:Name="ThemeDark"
                                             Grid.Column="1"
                                             Content="{DynamicResource ThemeDark}"
                                             GroupName="Theme"
                                             Tag="Dark"
                                             Checked="Theme_Checked" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,0,0,14"
                        Style="{StaticResource SectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <Border DockPanel.Dock="Right"
                                    Padding="9,4"
                                    Background="{DynamicResource AccentWarningSoftBrush}"
                                    CornerRadius="6">
                                <TextBlock Text="Velopack"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentWarningBrush}" />
                            </Border>
                            <TextBlock Text="{DynamicResource UpdateSectionTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="17"
                                       Foreground="{DynamicResource StrongTextBrush}" />
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource UpdateCurrentVersionLabel}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,16,10" />
                            <TextBlock x:Name="CurrentVersionText"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource StrongTextBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />

                            <TextBlock Grid.Row="1"
                                       Text="{DynamicResource UpdateStatusLabel}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,16,10" />
                            <TextBlock x:Name="UpdateStatusText"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource StrongTextBrush}"
                                       Margin="0,0,0,10"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2"
                                       Text="{DynamicResource UpdateLastCheckedLabel}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,16,0" />
                            <TextBlock x:Name="UpdateLastCheckedText"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource StrongTextBrush}" />
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <ui:Button x:Name="CheckForUpdatesButton"
                                       Content="{DynamicResource UpdateCheckNow}"
                                       Click="CheckForUpdates_Click"
                                       Style="{StaticResource BluePrimaryButtonStyle}" />
                            <ui:Button x:Name="OpenReleasesButton"
                                       Content="{DynamicResource UpdateOpenReleases}"
                                       Click="OpenReleases_Click"
                                       Margin="10,0,0,0"
                                       Appearance="Secondary"
                                       Padding="16,8" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <DockPanel LastChildFill="True">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RepoSectionTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="17"
                                       Foreground="{DynamicResource StrongTextBrush}"
                                       Margin="0,0,0,7" />
                            <TextBlock Text="{DynamicResource RepoDescription}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button x:Name="OpenRepoButton"
                                   DockPanel.Dock="Right"
                                   Content="{DynamicResource RepoOpenButton}"
                                   Click="OpenRepo_Click"
                                   Appearance="Secondary"
                                   Padding="16,8"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

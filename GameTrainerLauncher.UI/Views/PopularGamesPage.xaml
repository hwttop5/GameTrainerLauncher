<Page x:Class="GameTrainerLauncher.UI.Views.PopularGamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:GameTrainerLauncher.UI.Controls"
      Title="{DynamicResource NavPopular}"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="True">
                <StackPanel>
                    <TextBlock Text="{DynamicResource NavPopular}"
                               Style="{StaticResource PageTitleTextStyle}" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Visibility="{Binding PageFeedback.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:InfoBar IsClosable="True"
                            IsOpen="{Binding PageFeedback.IsOpen, Mode=TwoWay}"
                            Severity="{Binding PageFeedback.Severity}"
                            Title="{Binding PageFeedback.Title}"
                            Message="{Binding PageFeedback.Message}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Border VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Panel.ZIndex="1000"
                    Padding="28"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="48"
                                     Height="48"
                                     HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource StatusDownloading}"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="PopularScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Trainers}"
                                  HorizontalAlignment="Stretch"
                                  Margin="-10,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           HorizontalAlignment="Left" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:TrainerCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Button Content="{DynamicResource BtnLoadMore}"
                               Command="{Binding LoadMoreCommand}"
                               Visibility="{Binding IsLoadMoreVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,6"
                               Appearance="Secondary"
                               Width="220"
                               Padding="0,9" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

<Page x:Class="GameTrainerLauncher.UI.Views.MyGamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:GameTrainerLauncher.UI.Converters"
      Title="{DynamicResource NavMyGames}"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.Resources>
        <converters:LessThanConverter x:Key="LessThanConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="True">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource NavMyGames}"
                                   Style="{StaticResource PageTitleTextStyle}" />
                        <Border Margin="14,2,0,0"
                                Padding="9,4"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Games.Count}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StrongTextBrush}" />
                                <TextBlock Text=" "
                                           FontSize="11" />
                                <TextBlock Text="{DynamicResource LabelTrainerCountSuffix}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal"
                                    Margin="18,4,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="::"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource FaintTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource LabelDragSort}"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource MyGamesPageHint}"
                               Margin="0,5,0,0"
                               Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Visibility="{Binding PageFeedback.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:InfoBar IsClosable="True"
                            IsOpen="{Binding PageFeedback.IsOpen, Mode=TwoWay}"
                            Severity="{Binding PageFeedback.Severity}"
                            Title="{Binding PageFeedback.Title}"
                            Message="{Binding PageFeedback.Message}" />
            </Border>
        </Grid>

        <ListView x:Name="GamesList"
                  Grid.Row="1"
                  ItemsSource="{Binding Games}"
                  SelectionMode="Single"
                  AllowDrop="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent"
                  BorderThickness="0"
                  Visibility="{Binding HasGames, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Cursor="Arrow">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ListItemHoverBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="::"
                                       Foreground="{DynamicResource FaintTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       ToolTip="{DynamicResource LabelDragSort}" />

                            <Border Grid.Column="1"
                                    Width="56"
                                    Height="56"
                                    CornerRadius="6"
                                    Background="{DynamicResource CoverPlaceholderBrush}"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Games24"
                                                   FontSize="24"
                                                   Foreground="{DynamicResource FaintTextBrush}">
                                        <ui:SymbolIcon.Visibility>
                                            <MultiBinding Converter="{StaticResource GameCoverPlaceholderFromPartsConverter}">
                                                <Binding Path="MatchedTrainer.ImageUrl" />
                                                <Binding Path="CoverUrl" />
                                                <Binding Path="Id" />
                                            </MultiBinding>
                                        </ui:SymbolIcon.Visibility>
                                    </ui:SymbolIcon>
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource GameCoverFromPartsConverter}"
                                                          ConverterParameter="128">
                                                <Binding Path="MatchedTrainer.ImageUrl" />
                                                <Binding Path="CoverUrl" />
                                                <Binding Path="Id" />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Margin="14,0,16,0">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="16"
                                           Foreground="{DynamicResource StrongTextBrush}"
                                           MaxWidth="520"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MatchedTrainer.Version}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MatchedTrainer.Version}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{DynamicResource LabelTrainerVersion}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding MatchedTrainer.Version}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{DynamicResource FaintTextBrush}"
                                               Margin="12,0,0,0">
                                        <TextBlock.Text>
                                            <Binding Path="MatchedTrainer.LastUpdated" StringFormat="{}{0:yyyy.MM.dd}" TargetNullValue="-" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <ProgressBar Value="{Binding MatchedTrainer.DownloadProgress}"
                                             Maximum="100"
                                             Height="5"
                                             Margin="0,8,0,0">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource IsCurrentDownloadingConverter}">
                                                            <Binding />
                                                            <Binding Path="DataContext.CurrentDownloadingGame" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <TextBlock Text="{Binding MatchedTrainer.DownloadStatusText}"
                                           FontSize="11"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource IsCurrentDownloadingConverter}">
                                                            <Binding />
                                                            <Binding Path="DataContext.CurrentDownloadingGame" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,0">
                                <Border HorizontalAlignment="Left"
                                        Padding="8,3"
                                        CornerRadius="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentDangerSoftBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MatchedTrainer.IsDownloaded}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSuccessSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{DynamicResource StatusNotDownloaded}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentDangerBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MatchedTrainer.IsDownloaded}" Value="True">
                                                        <Setter Property="Text" Value="{DynamicResource StatusDownloaded}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource FaintTextBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding MatchedTrainer.Version, TargetNullValue=-}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <ui:Button Command="{Binding DataContext.DownloadTrainerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}"
                                           Margin="0,0,8,0">
                                    <ui:Button.IsEnabled>
                                        <MultiBinding Converter="{StaticResource CanDownloadConverter}">
                                            <Binding />
                                            <Binding Path="DataContext.CurrentDownloadingGame" RelativeSource="{RelativeSource AncestorType=Page}" />
                                        </MultiBinding>
                                    </ui:Button.IsEnabled>
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource BluePrimaryButtonStyle}">
                                            <Setter Property="Content" Value="{DynamicResource BtnDownload}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MatchedTrainer.IsDownloaded}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource IsCurrentDownloadingConverter}">
                                                            <Binding />
                                                            <Binding Path="DataContext.CurrentDownloadingGame" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Content" Value="{DynamicResource StatusDownloading}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>

                                <ui:Button Command="{Binding DataContext.LaunchTrainerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}"
                                           Margin="0,0,8,0">
                                    <ui:Button.IsEnabled>
                                        <MultiBinding Converter="{StaticResource CanLaunchConverter}">
                                            <Binding />
                                            <Binding Path="DataContext.CurrentLaunchingGame" RelativeSource="{RelativeSource AncestorType=Page}" />
                                        </MultiBinding>
                                    </ui:Button.IsEnabled>
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource BluePrimaryButtonStyle}">
                                            <Setter Property="Content" Value="{DynamicResource BtnLaunch}" />
                                            <Setter Property="ToolTip" Value="{DynamicResource BtnLaunch}" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource IsCurrentLaunchingConverter}">
                                                            <Binding />
                                                            <Binding Path="DataContext.CurrentLaunchingGame" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Content" Value="{DynamicResource StatusLaunching}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MatchedTrainer}" Value="{x:Null}">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MatchedTrainer.IsDownloaded}" Value="False">
                                                    <Setter Property="ToolTip" Value="{DynamicResource MsgDownloadFirst}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>

                                <ui:Button Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}"
                                           Content="{DynamicResource BtnRemove}"
                                           Style="{StaticResource DangerButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="1"
              Visibility="{Binding ShowNoGamesEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="420"
                    Padding="30"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Games24"
                                   FontSize="58"
                                   Foreground="{DynamicResource FaintTextBrush}"
                                   Margin="0,0,0,16" />
                    <TextBlock Text="{DynamicResource MsgNoGamesTitle}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource EmptyStateTitleBrush}" />
                    <TextBlock Text="{DynamicResource MsgNoGamesDescription}"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,0,18"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="340" />
                    <ui:Button Content="{DynamicResource BtnExplorePopular}"
                               Command="{Binding DataContext.NavigateToPopularCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               Style="{StaticResource BluePrimaryButtonStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

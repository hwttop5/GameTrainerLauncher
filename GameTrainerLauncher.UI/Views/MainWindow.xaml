<ui:FluentWindow x:Class="GameTrainerLauncher.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:GameTrainerLauncher.UI.Models"
        Title="{DynamicResource AppTitle}" Height="800" Width="1280" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.ico"
        WindowBackdropType="None"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <Style x:Key="NotificationCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.65" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavRailStyle" TargetType="Border">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="-12,8,0,8" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ShellContentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title=""
                     Grid.Row="0"
                     Panel.ZIndex="100"
                     Background="Transparent" />

        <Grid Grid.Row="0"
              Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource ShellSidebarBrush}"
                    BorderBrush="{DynamicResource ShellSidebarBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="12,22,12,22">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <Image Source="/Assets/logo.png"
                                       Width="24"
                                       Height="24"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource AppTitle}"
                                           Foreground="{DynamicResource StrongTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="FLiNG utility"
                                           Foreground="{DynamicResource FaintTextBrush}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Border Style="{StaticResource NavRailStyle}"
                                    Visibility="{Binding IsPopularSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button Command="{Binding NavigateToCommand}"
                                       CommandParameter="Popular"
                                       AutomationProperties.Name="{DynamicResource NavPopular}"
                                       Appearance="Secondary"
                                       Tag="{Binding IsPopularSelected}"
                                       Style="{StaticResource ShellNavButtonStyle}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <ui:SymbolIcon Symbol="Fire24"
                                                   Width="22"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource NavPopular}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <Grid>
                            <Border Style="{StaticResource NavRailStyle}"
                                    Visibility="{Binding IsMyGamesSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button Command="{Binding NavigateToCommand}"
                                       CommandParameter="MyGames"
                                       AutomationProperties.Name="{DynamicResource NavMyGames}"
                                       Appearance="Secondary"
                                       Tag="{Binding IsMyGamesSelected}"
                                       Style="{StaticResource ShellNavButtonStyle}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <ui:SymbolIcon Symbol="Games24"
                                                   Width="22"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource NavMyGames}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <Grid>
                            <Border Style="{StaticResource NavRailStyle}"
                                    Visibility="{Binding IsSettingsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button x:Name="NavSettingsButton"
                                       Command="{Binding NavigateToCommand}"
                                       CommandParameter="Settings"
                                       AutomationProperties.Name="{DynamicResource NavSettings}"
                                       Appearance="Secondary"
                                       Tag="{Binding IsSettingsSelected}"
                                       Style="{StaticResource ShellNavButtonStyle}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <ui:SymbolIcon Symbol="Settings24"
                                                   Width="22"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource NavSettings}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom"
                            Margin="12,0,12,28"
                            Background="Transparent">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center">
                                <Run Text="{DynamicResource ShellVersionPrefix}" />
                                <Run Text=" 1.2.2" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1"
                  Margin="28,45,28,24"
                  ClipToBounds="True">
                <Frame x:Name="MainFrame"
                       NavigationUIVisibility="Hidden"
                       Background="{DynamicResource ApplicationBackgroundBrush}" />

                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Panel.ZIndex="20">
                    <Grid Width="440"
                          Height="34"
                          HorizontalAlignment="Right"
                          Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="34"
                                Padding="10,0"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="Search24"
                                               Width="22"
                                               FontSize="15"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />

                                <Grid Grid.Column="1"
                                      VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource SearchPlaceholder}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding SearchText, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                                    <TextBox Focusable="True"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ToolbarSearchPlainTextBoxStyle}"
                                             VerticalAlignment="Center">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>
                            </Grid>
                        </Border>

                        <ui:Button x:Name="SearchButton"
                                   Grid.Column="2"
                                   Content="{DynamicResource BtnSearch}"
                                   Command="{Binding SearchCommand}"
                                   Width="62"
                                   Height="34"
                                   Padding="0"
                                   FontSize="13"
                                   Style="{StaticResource BluePrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <ItemsControl x:Name="NotificationsItemsControl"
                      Grid.RowSpan="2"
                      Margin="0,0,24,24"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Panel.ZIndex="5000">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:AppNotificationItem}">
                    <Border Width="390"
                            Margin="0,0,0,12"
                            Padding="16"
                            Background="{DynamicResource NotificationSurfaceBrush}"
                            BorderBrush="{DynamicResource NotificationSurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24"
                                              ShadowDepth="4"
                                              Opacity="1"
                                              Color="{DynamicResource NotificationShadowColor}" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="16"
                                    Background="{Binding AccentBrush}"
                                    VerticalAlignment="Top"
                                    Margin="0,0,12,0">
                                <TextBlock Text="{Binding IconGlyph}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="Bold" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource NotificationTitleBrush}" />
                                <TextBlock Text="{Binding Message}"
                                           Margin="0,6,0,0"
                                           FontSize="13"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource NotificationMessageBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Margin="12,0,0,0"
                                    Click="NotificationClose_Click"
                                    Style="{StaticResource NotificationCloseButtonStyle}">
                                <TextBlock Text="x"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource NotificationCloseBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</ui:FluentWindow>

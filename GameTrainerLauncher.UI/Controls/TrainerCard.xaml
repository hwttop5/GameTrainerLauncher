<UserControl x:Class="GameTrainerLauncher.UI.Controls.TrainerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="202"
             Height="270"
             MinHeight="252">
    <Border Margin="8"
            Padding="0"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True"
            Cursor="Hand"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Opacity="0.35"
                              Color="{DynamicResource ElevatedShadowColor}" />
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.015" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.015" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Height="254">
            <Grid.RowDefinitions>
                <RowDefinition Height="128" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource CoverPlaceholderBrush}"
                    ClipToBounds="True">
                <Grid>
                    <ui:SymbolIcon Symbol="Games24"
                                   FontSize="36"
                                   Foreground="{DynamicResource FaintTextBrush}"
                                   Visibility="{Binding ImageUrl, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10"
                            Padding="7,3"
                            Background="#CC11161B"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="FLiNG"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="12,8,12,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding DisplayTitle}"
                           Foreground="{DynamicResource StrongTextBrush}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           LineHeight="17"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="38" />

                <TextBlock Grid.Row="1"
                           Text="{Binding SecondaryDisplayTitle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           Margin="0,3,0,0"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SecondaryDisplayTitle}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SecondaryDisplayTitle}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Grid.Row="2"
                      Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Foreground="{DynamicResource FaintTextBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <Binding Path="LastUpdated" StringFormat="{}{0:yyyy.MM.dd}" TargetNullValue="-" />
                        </TextBlock.Text>
                    </TextBlock>

                    <Border Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="7,2"
                            Background="{DynamicResource AccentSuccessSoftBrush}"
                            CornerRadius="5"
                            HorizontalAlignment="Right"
                            Visibility="{Binding IsDownloaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource StatusAdded}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentSuccessBrush}" />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="3"
                            Margin="0,6,0,0"
                            Visibility="{Binding IsAdding, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Value="{Binding DownloadProgress}"
                                 Maximum="100"
                                 Height="5" />
                    <TextBlock Text="{Binding DownloadStatusText}"
                               Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Margin="12,4,12,10">
                <ui:Button x:Name="AddButton"
                           Command="{Binding DataContext.AddToMyGamesCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                           CommandParameter="{Binding}"
                           HorizontalAlignment="Stretch"
                           Foreground="{Binding RelativeSource={RelativeSource Self}, Path=IsEnabled, Converter={StaticResource EnabledToPrimaryForegroundBrushConverter}}"
                           Padding="0,6"
                           FontSize="12">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource BluePrimaryButtonStyle}">
                            <Setter Property="Content" Value="{DynamicResource BtnAdd}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Content" Value="{DynamicResource StatusAdded}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAddPending}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Content" Value="{DynamicResource StatusPreparingAdd}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAdding}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Content" Value="{DynamicResource StatusAdding}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
